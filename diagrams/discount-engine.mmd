classDiagram
    direction TB

    namespace Presentation {
        class CalculateOrderDiscounts {
            <<endpoint>>
            POST /orders/discounts
        }
    }

    namespace Application {
        class CalculateOrderDiscountsQuery {
            <<record>>
            +int CustomerId
            +decimal Price
            +string Currency
            +IReadOnlyCollection~string~ CouponCodes
        }
        class CalculateOrderDiscountsQueryHandler {
            +Handle(query, ct) Result~DiscountBreakdownResponse~
        }
        class Order {
            <<record>>
            +int CustomerId
            +Money Price
            +IReadOnlyCollection~string~ CouponCodes
        }
        class IDiscountProvider {
            <<interface>>
            +int Priority
            +GetEligibleDiscountsAsync(Order, ct) Result~IReadOnlyList~Discount~~
        }
        class PriceListDiscountProvider {
            Priority = 100
            Source = PriceList
        }
        class PromotionDiscountProvider {
            Priority = 200
            Source = Promotion
        }
        class CouponDiscountProvider {
            Priority = 300
            Source = Coupon
        }
        class IPriceListReader {
            <<interface>>
            +GetActiveForCustomerAsync(customerId, ct) IReadOnlyList~PriceListDiscount~
        }
        class IPromotionReader {
            <<interface>>
            +GetActiveNotEndedAsync(utcNow, ct) IReadOnlyList~Promotion~
        }
        class ICouponReader {
            <<interface>>
            +GetActiveUnexpiredByCodesAsync(codes, utcNow, ct) IReadOnlyList~Coupon~
        }
    }

    namespace Domain {
        class PriceListDiscount {
            +int CustomerId
            +string Name
            +DiscountType Type
            +decimal Value
            +bool IsActive
            +IsEligibleFor(customerId) bool
        }
        class Promotion {
            +string Name
            +DateTime StartsAtUtc
            +DateTime EndsAtUtc
            +bool IsActive
            +IsEligibleAt(utcNow) bool
        }
        class Coupon {
            +string Code
            +string Name
            +DateTime? ExpiresAtUtc
            +bool IsActive
            +IsRedeemableAt(utcNow) bool
        }
        class Discount {
            <<abstract>>
            +string Name
            +string Source
            +DiscountType Type
            +string Rule
            +Create(name, source, type, value, currency)$ Result~Discount~
            +AppliesTo(Currency currency)* bool
            ~CalculateDeduction(Money runningPrice)* Result~Money~
        }
        class PercentageDiscount {
            +decimal Percentage
            +AppliesTo(Currency currency) bool
            ~CalculateDeduction(Money runningPrice) Result~Money~
        }
        class FixedAmountDiscount {
            +Money Amount
            +AppliesTo(Currency currency) bool
            ~CalculateDeduction(Money runningPrice) Result~Money~
        }
        class DiscountType {
            <<enumeration>>
            Percentage
            FixedAmount
        }
        class DiscountBreakdown {
            +Money OriginalPrice
            +IReadOnlyList~DiscountLine~ Lines
            +Money TotalDiscount
            +Money FinalPrice
            +Apply(Money price, IEnumerable~PrioritizedDiscounts~ sources)$ Result~DiscountBreakdown~
        }
        class PrioritizedDiscounts {
            <<record>>
            +int Priority
            +IReadOnlyList~Discount~ Discounts
        }
        class DiscountLine {
            <<record>>
            +string Name
            +string Source
            +DiscountType Type
            +string Rule
            +Money PriceBefore
            +Money Deducted
            +Money PriceAfter
        }
    }

    namespace Infrastructure {
        class PriceListReader {
            EF Core, AsNoTracking
        }
        class PromotionReader {
            EF Core, AsNoTracking
        }
        class CouponReader {
            EF Core, AsNoTracking
        }
        class PricingDbContext {
            schema pricing
        }
    }

    CalculateOrderDiscounts ..> CalculateOrderDiscountsQuery : sends
    CalculateOrderDiscountsQueryHandler ..> CalculateOrderDiscountsQuery : handles
    CalculateOrderDiscountsQueryHandler ..> Order : builds
    CalculateOrderDiscountsQueryHandler --> "*" IDiscountProvider : calls one by one, lowest Priority first
    CalculateOrderDiscountsQueryHandler ..> DiscountBreakdown : Apply

    PriceListDiscountProvider ..|> IDiscountProvider
    PromotionDiscountProvider ..|> IDiscountProvider
    CouponDiscountProvider ..|> IDiscountProvider

    PriceListDiscountProvider --> IPriceListReader
    PromotionDiscountProvider --> IPromotionReader
    CouponDiscountProvider --> ICouponReader
    IPriceListReader ..> PriceListDiscount : loads
    IPromotionReader ..> Promotion : loads
    ICouponReader ..> Coupon : loads

    IDiscountProvider ..> Discount : returns
    Discount <|-- PercentageDiscount
    Discount <|-- FixedAmountDiscount
    Discount --> DiscountType
    DiscountBreakdown ..> "*" PrioritizedDiscounts : orders by Priority
    PrioritizedDiscounts o-- "*" Discount
    DiscountBreakdown *-- "*" DiscountLine

    PriceListReader ..|> IPriceListReader
    PromotionReader ..|> IPromotionReader
    CouponReader ..|> ICouponReader
    PriceListReader --> PricingDbContext
    PromotionReader --> PricingDbContext
    CouponReader --> PricingDbContext
