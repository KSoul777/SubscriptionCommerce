<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Visual Studio's container tooling: the Dockerfile builds from the repository root, and the API is the
       service that docker-compose.dcproj starts and debugs. -->
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <DockerComposeProjectPath>..\..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Customers\SubscriptionCommerce.Modules.Customers.Infrastructure\SubscriptionCommerce.Modules.Customers.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Customers\SubscriptionCommerce.Modules.Customers.Presentation\SubscriptionCommerce.Modules.Customers.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Pricing\SubscriptionCommerce.Modules.Pricing.Infrastructure\SubscriptionCommerce.Modules.Pricing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Pricing\SubscriptionCommerce.Modules.Pricing.Presentation\SubscriptionCommerce.Modules.Pricing.Presentation.csproj" />
  </ItemGroup>

</Project>
