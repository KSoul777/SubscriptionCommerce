{
  "ConnectionStrings": {
    "Database": "Server=subscriptioncommerce.database;Database=SubscriptionCommerce;User Id=sa;Password=Local_dev_Passw0rd!;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://subscriptioncommerce.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "SubscriptionCommerce.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://subscriptioncommerce.jaeger:4317"
}
